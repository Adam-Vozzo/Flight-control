    "test": "node --test tests/*.test.mjs",
    "icons": "node scripts/make-icons.mjs",
    "build:single": "node scripts/build-single.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "http-server": "14.1.1"
  }
}
