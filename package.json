{
  "name": "flight-control",
  "version": "1.0.0",
  "private": true,
  "description": "Draw flight paths and land every plane. A tribute to Firemint's 2009 iPhone classic, rebuilt as an installable web game.",
  "type": "module",
  "scripts": {
